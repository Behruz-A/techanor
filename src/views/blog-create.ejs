<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/products.css" /><link rel="stylesheet" type="text/css" href="/css/blogs.css" /><link rel="stylesheet" type="text/css" href="/css/blog-video.css" />
<script>(function(){try{document.documentElement.dataset.theme=localStorage.getItem('techanor-admin-theme')||'light'}catch(e){document.documentElement.dataset.theme='light'}})();</script>
<body class="products_page"><div class="admin_shell">
<aside class="admin_sidebar" id="admin-sidebar"><a class="sidebar_brand" href="/admin"><img class="sidebar_brand_logo" src="/img/logoipsum-249.svg" alt=""/><span><strong>Techanor</strong><small>ADMIN PANEL</small></span></a><p class="sidebar_label" data-i18n="general">GENERAL</p><nav class="sidebar_navigation"><a href="/admin" data-i18n="home">Home</a><a href="/admin/product/all" data-i18n="products">Products</a><a href="/admin/analytics">Analytics</a><a href="/admin/marketing">Marketing</a><a href="/admin/user/all" data-i18n="users">Users</a><a class="is_active" href="/admin/blog/all" data-i18n="blogs">Blogs</a><button class="sidebar_future_item" type="button" data-coming-soon="AI"><span>AI</span><em>NEW</em></button><button class="sidebar_future_item" type="button" data-coming-soon="AI Assistant"><span>AI Assistant</span><em>NEW</em></button></nav><div class="sidebar_footer"><span><i></i><span data-i18n="systemOnline">SYSTEM ONLINE</span></span><a class="sidebar_logout" href="/admin/logout" data-i18n="logout">Logout</a></div></aside>
<section class="admin_workspace"><header class="workspace_header"><button class="sidebar_toggle" id="sidebar-toggle" type="button">&#9776;</button><label class="global_search"><span>&#128269;</span><input id="blog-global-search" type="search" data-i18n-placeholder="navigationSearch" placeholder="Search pages..."/></label><div class="header_actions"><button class="theme_toggle" id="theme-toggle" type="button"><img class="theme_icon theme_icon_sun" src="/img/marketing/sun-svgrepo-com.svg" alt=""/><span class="theme_icon theme_icon_moon">&#9790;</span></button><label class="language_picker"><span>&#25991;</span><select id="language-select"><option value="en">English</option><option value="ko">한국어</option><option value="uz">O‘zbek</option></select></label><div class="admin_identity"><img src="/img/Asensio.png" alt="Ryan"/><div><strong>Ryan</strong><small>Admin</small></div></div></div></header>
<main class="products_content blogs_content"><section class="products_heading"><div><h1 data-i18n="createBlog">Create Blog Post</h1><nav class="products_breadcrumb"><a href="/admin" data-i18n="home">Home</a><span>›</span><a href="/admin/blog/all" data-i18n="blogs">Blogs</a><span>›</span><strong data-i18n="newPost">New post</strong></nav></div></section>
<form class="product_form blog_form" action="/admin/blog/create" method="POST" enctype="multipart/form-data" novalidate><div class="form_heading"><div><p class="section_label" data-i18n="editorial">EDITORIAL</p><h2 data-i18n="articleDetails">Article details</h2><p data-i18n="articleSubtitle">Prepare an article and publish it when it is ready.</p></div><a class="close_form_button" href="/admin/blog/all">×</a></div><% if(typeof error!=='undefined'&&error){ %><div class="blog_error" role="alert"><%= error %></div><% } %>
<div class="blog_form_body"><div class="form_grid"><div class="form_field field_full"><label for="blog-title"><span data-i18n="title">Title</span> <span class="required_mark">*</span></label><input id="blog-title" name="blogPostTitle" type="text" minlength="6" maxlength="160" data-i18n-placeholder="titlePlaceholder" placeholder="Enter a clear, engaging title" value="<%= typeof formData!=='undefined'?formData.blogPostTitle||'':'' %>" required/></div><div class="form_field"><label for="blog-category"><span data-i18n="category">Category</span> <span class="required_mark">*</span></label><select id="blog-category" name="blogPostCategory" required><option value="" disabled <%= typeof formData==='undefined'||!formData.blogPostCategory?'selected':'' %> data-i18n="selectCategory">Select category</option><% blogCategories.forEach(function(category){ %><option value="<%= category %>" <%= typeof formData!=='undefined'&&formData.blogPostCategory===category?'selected':'' %>><%= category.replace(/_/g,' ') %></option><% }) %></select></div><div class="form_field"><label for="blog-status"><span data-i18n="initialStatus">Initial status</span> <span class="required_mark">*</span></label><select id="blog-status" name="blogPostStatus" required><option value="DRAFT" <%= typeof formData==='undefined'||formData.blogPostStatus!=='PUBLISHED'?'selected':'' %>>Draft</option><option value="PUBLISHED" <%= typeof formData!=='undefined'&&formData.blogPostStatus==='PUBLISHED'?'selected':'' %>>Published</option></select></div><div class="form_field field_full"><label for="blog-content"><span data-i18n="content">Content</span> <span class="required_mark">*</span></label><textarea id="blog-content" name="blogPostContent" rows="12" minlength="40" data-i18n-placeholder="contentPlaceholder" placeholder="Write a useful, detailed article..." required><%= typeof formData!=='undefined'?formData.blogPostContent||'':'' %></textarea><small class="field_help" data-i18n="contentHelp">Use at least 40 meaningful characters.</small></div></div>
<section class="blog_media_section"><div class="blog_media_heading"><h3 data-i18n="media">Media</h3><p data-i18n="mediaSubtitle">Add a cover image and an optional product video.</p></div><div class="blog_media_grid"><label class="blog_upload_card" for="blog-image"><span class="upload_icon">&#8593;</span><strong data-i18n="coverImage">Cover image</strong><small data-i18n="imageRules">JPG, PNG or WebP · max 5 MB</small><img id="blog-image-preview" alt="Cover preview" hidden/><input id="blog-image" name="blogPostImage" type="file" accept="image/jpeg,image/png,image/webp"/></label><div class="blog_video_options"><label class="blog_upload_card" for="blog-video"><span class="upload_icon">&#9654;</span><strong data-i18n="productVideo">Upload video</strong><small data-i18n="videoRules">MP4, WebM or MOV · max 50 MB</small><video id="blog-video-preview" controls hidden></video><input id="blog-video" name="blogPostVideo" type="file" accept="video/mp4,video/webm,video/quicktime"/></label><div class="video_option_divider"><span data-i18n="or">OR</span></div><label class="youtube_url_field" for="blog-video-url"><span data-i18n="youtubeLink">YouTube link</span><input id="blog-video-url" name="blogPostVideoUrl" type="url" inputmode="url" data-i18n-placeholder="youtubePlaceholder" placeholder="https://www.youtube.com/watch?v=..." value="<%= typeof formData!=='undefined'?formData.blogPostVideoUrl||'':'' %>"/><small data-i18n="youtubeHelp">Paste a YouTube video, Shorts or youtu.be link.</small></label></div></div></section></div>
<div class="form_actions blog_form_actions"><a class="secondary_button blog_cancel_link" href="/admin/blog/all" data-i18n="cancel">Cancel</a><button class="secondary_button" type="submit" data-blog-submit-status="DRAFT" data-i18n="saveDraft">Save draft</button><button class="primary_button" type="submit" data-blog-submit-status="PUBLISHED" data-i18n="publish">Publish</button></div></form></main></section></div><script src="/js/blog-admin.js"></script></body><%- include('includes/footer') %>
