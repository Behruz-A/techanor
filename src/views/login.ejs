<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />
<link rel="stylesheet" type="text/css" href="/css/google-auth.css" />

<body class="auth-page">
  <form class="login-container" action="/admin/login" METHOD="POST">
    <div class="login-frame">
      <div class="login-top">
        <span>Enter</span>
        <div>Go back <a href="/admin" style="color: #6440fb">Home</a></div>
        <p>
          Not registered yet?
          <a href="/admin/signup" style="color: #6440fb">Signup</a>
        </p>
      </div>
      <div class="google-auth" data-client-id="<%= googleClientId %>">
        <div class="google-auth-button"></div>
        <p class="google-auth-error" role="alert"></p>
      </div>
      <div class="auth-divider"><span>OR</span></div>
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>Restaurant *</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>Password *</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">Login</button>
    </div>
  </form>

  <script src="/js/google-auth.js"></script>
  <script
    src="https://accounts.google.com/gsi/client"
    async
    defer
    onload="initializeGoogleAuth()"
  ></script>
</body>

<%- include('includes/footer') %>
