<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />
<link rel="stylesheet" type="text/css" href="/css/marketing.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />

<script>
  (function restoreTechanorTheme() {
    try {
      document.documentElement.dataset.theme = localStorage.getItem("techanor-admin-theme") || "light";
    } catch (error) {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>

<body class="products_page marketing_page">
  <div class="admin_shell">
    <aside class="admin_sidebar" id="admin-sidebar">
      <a class="sidebar_brand" href="/admin" aria-label="Techanor home">
        <img class="sidebar_brand_logo" src="/img/logoipsum-249.svg" alt="" aria-hidden="true" />
        <span><strong>Techanor</strong><small>ADMIN PANEL</small></span>
      </a>

      <p class="sidebar_label">MENU</p>
      <nav class="sidebar_navigation marketing_navigation" aria-label="Admin navigation">
        <a href="/admin"><span class="nav_icon">⌂</span><span>Home</span></a>
        <a href="/admin/product/all"><span class="nav_icon">▦</span><span>Products</span></a>
        <a href="/admin/analytics"><span class="nav_icon">⌁</span><span>Analytics</span></a>
        <a class="is_active" href="/admin/marketing" aria-current="page"><span class="nav_icon">⌁</span><span>Marketing</span></a>
        <a href="/admin/user/all"><span class="nav_icon">♙</span><span>Users</span></a>
        <a href="/admin/blog/all"><span class="nav_icon">▤</span><span>Blogs</span></a>
        <button class="sidebar_future_item" type="button" data-coming-soon="AI"><span>AI</span><em>NEW</em></button>
        <button class="sidebar_future_item" type="button" data-coming-soon="AI Assistant"><span>AI Assistant</span><em>NEW</em></button>
      </nav>

      <div class="sidebar_footer">
        <span><i></i><span data-i18n="systemOnline">SYSTEM ONLINE</span></span>
        <a class="sidebar_logout" href="/admin/logout" onclick="return confirm('Do you want to logout?')"><span>↪</span><span data-i18n="logout">Logout</span></a>
      </div>
    </aside>

    <section class="admin_workspace">
      <header class="workspace_header">
        <button class="sidebar_toggle" id="sidebar-toggle" type="button" aria-label="Toggle navigation">☰</button>
        <label class="global_search">
          <span>⌕</span>
          <input id="product-search" type="search" placeholder="Search campaigns..." />
        </label>
        <div class="header_actions">
          <button class="theme_toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <span class="theme_icon theme_icon_sun" aria-hidden="true">☀</span>
            <span class="theme_icon theme_icon_moon" aria-hidden="true">☾</span>
          </button>
          <label class="language_picker" for="language-select">
            <span>文</span>
            <select id="language-select" aria-label="Language">
              <option value="en" selected>English</option>
              <option value="ko">한국어</option>
              <option value="uz">O‘zbek</option>
            </select>
          </label>
          <div class="admin_identity">
            <img src="/img/Asensio.png" alt="Ryan" />
            <div><strong>Ryan</strong><small>Admin</small></div>
          </div>
        </div>
      </header>

      <main class="marketing_content">
        <section class="metric_grid" aria-label="Marketing metrics">
          <article class="metric_card"><span class="metric_icon">☆</span><p>Avg. Client Rating</p><div><strong>7.8/10</strong><span class="trend trend_up">+20%</span></div><small>vs last month</small></article>
          <article class="metric_card"><span class="metric_icon">♙</span><p>Social Followers</p><div><strong>5,934</strong><span class="trend trend_down">−3.59%</span></div><small>vs last month</small></article>
          <article class="metric_card"><span class="metric_icon">$</span><p>Total Revenue</p><div><strong>$9,758</strong><span class="trend trend_up">+15%</span></div><small>vs last month</small></article>
        </section>

        <section class="analytics_grid">
          <article class="marketing_card traffic_chart_card">
            <div class="marketing_card_header"><div><h2>Impressions & Data Traffic</h2><p>Jan 1, 2026 – Aug 16, 2026</p></div><div><strong>$9,758.00</strong><span class="trend trend_up">+7.96%</span></div></div>
            <div class="chart_legend"><span><i class="legend_primary"></i>Impressions</span><span><i class="legend_secondary"></i>Engagement</span></div>
            <svg class="traffic_chart" viewBox="0 0 760 280" role="img" aria-label="Marketing traffic chart">
              <defs><linearGradient id="chartFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6366F1" stop-opacity=".25"/><stop offset="1" stop-color="#6366F1" stop-opacity="0"/></linearGradient></defs>
              <g class="chart_grid"><line x1="45" y1="35" x2="740" y2="35"/><line x1="45" y1="95" x2="740" y2="95"/><line x1="45" y1="155" x2="740" y2="155"/><line x1="45" y1="215" x2="740" y2="215"/></g>
              <path class="chart_area" d="M45 205 C95 190 120 150 170 165 S245 205 300 166 S370 135 420 115 S490 145 535 92 S610 64 655 75 S705 42 740 55 L740 250 L45 250 Z"/>
              <path class="chart_line chart_line_primary" d="M45 205 C95 190 120 150 170 165 S245 205 300 166 S370 135 420 115 S490 145 535 92 S610 64 655 75 S705 42 740 55"/>
              <path class="chart_line chart_line_secondary" d="M45 232 C110 238 130 215 178 222 S252 240 310 214 S375 194 430 178 S510 187 565 151 S645 132 690 110 S720 118 740 105"/>
            </svg>
          </article>

          <article class="marketing_card traffic_stats">
            <div class="marketing_card_header"><h2>Traffic Stats</h2><button type="button">•••</button></div>
            <div class="period_tabs"><button class="is_active">Today</button><button>Week</button><button>Month</button></div>
            <div class="traffic_stat"><p>New Subscribers</p><strong>567K</strong><span class="trend_text up">+3.85% <small>than last week</small></span><div class="mini_bar"><i style="width:78%"></i></div></div>
            <div class="traffic_stat"><p>Conversion Rate</p><strong>276K</strong><span class="trend_text down">−5.39% <small>than last week</small></span><div class="mini_bar is_purple"><i style="width:58%"></i></div></div>
          </article>
        </section>

        <section class="marketing_bottom_grid">
          <article class="marketing_card campaign_card">
            <div class="marketing_card_header"><h2>Featured Campaigns</h2><button type="button">•••</button></div>
            <div class="campaign_head"><span>Creator</span><span>Campaign</span><span>Status</span></div>
            <div class="campaign_row" data-search-row data-search="wilson google search visibility growth success">
              <div class="campaign_creator"><img src="/img/marketing/wilson.jpg" alt="Wilson Gouse" /><strong>Wilson Gouse</strong></div>
              <div class="campaign_details"><img class="platform_logo" src="/img/marketing/google-ads.svg" alt="Google Ads" /><div><strong>Grow your brand visibility</strong><small>Ads campaign</small></div></div><span class="campaign_status success">Success</span>
            </div>
            <div class="campaign_row" data-search-row data-search="terry facebook new product audience pending">
              <div class="campaign_creator"><img src="/img/marketing/terry.jpg" alt="Terry Franci" /><strong>Terry Franci</strong></div>
              <div class="campaign_details"><img class="platform_logo" src="/img/marketing/facebook.svg" alt="Facebook" /><div><strong>Make better product ideas</strong><small>Ads campaign</small></div></div><span class="campaign_status pending">Pending</span>
            </div>
            <div class="campaign_row" data-search-row data-search="alena google ads website traffic success">
              <div class="campaign_creator"><img src="/img/marketing/alena.jpg" alt="Alena Franci" /><strong>Alena Franci</strong></div>
              <div class="campaign_details"><img class="platform_logo" src="/img/marketing/google-ads.svg" alt="Google Ads" /><div><strong>Increase your website traffic</strong><small>Ads campaign</small></div></div><span class="campaign_status success">Success</span>
            </div>
            <div class="campaign_row" data-search-row data-search="jocelyn instagram techanor brand story failed">
              <div class="campaign_creator"><img src="/img/marketing/jocelyn.jpg" alt="Jocelyn Kenter" /><strong>Jocelyn Kenter</strong></div>
              <div class="campaign_details"><img class="platform_logo" src="/img/marketing/instagram.svg" alt="Instagram" /><div><strong>Digital marketing that works</strong><small>Ads campaign</small></div></div><span class="campaign_status failed">Failed</span>
            </div>
            <div class="campaign_row" data-search-row data-search="brandon facebook self branding success">
              <div class="campaign_creator"><img src="/img/marketing/brandon.jpg" alt="Brandon Philips" /><strong>Brandon Philips</strong></div>
              <div class="campaign_details"><img class="platform_logo" src="/img/marketing/facebook.svg" alt="Facebook" /><div><strong>Self branding</strong><small>Ads campaign</small></div></div><span class="campaign_status success">Success</span>
            </div>
          </article>

          <article class="marketing_card source_card">
            <div class="marketing_card_header"><h2>Top Traffic Sources</h2><button type="button">•••</button></div>
            <div class="source_row"><img class="source_logo" src="/img/marketing/google.svg" alt="Google" /><strong>Google</strong><div><i style="width:79%"></i></div><span>79%</span></div>
            <div class="source_row"><img class="source_logo" src="/img/marketing/youtube.svg" alt="YouTube" /><strong>YouTube</strong><div><i style="width:55%"></i></div><span>55%</span></div>
            <div class="source_row"><img class="source_logo" src="/img/marketing/facebook.svg" alt="Facebook" /><strong>Facebook</strong><div><i style="width:48%"></i></div><span>48%</span></div>
            <div class="source_row"><img class="source_logo" src="/img/marketing/instagram.svg" alt="Instagram" /><strong>Instagram</strong><div><i style="width:42%"></i></div><span>42%</span></div>
            <button class="view_all_button" type="button">View All</button>
          </article>
        </section>
      </main>
    </section>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
