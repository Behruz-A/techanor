<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<%- include('includes/admin-theme') %>

<body class="products_page">
  <div class="admin_shell">
    <%- include('includes/admin-sidebar', { activePage: 'products' }) %>

    <section class="admin_workspace">
      <%- include('includes/admin-header', {
        searchId: 'product-search',
        searchPlaceholder: 'Search pages...',
        searchLabel: 'Global navigation search'
      }) %>

      <main class="products_content">
      <section class="products_heading">
        <div>
          <h1 data-i18n="products">Products</h1>
          <nav class="products_breadcrumb" aria-label="Breadcrumb">
            <a href="/admin" data-i18n="home">Home</a><span aria-hidden="true">›</span><strong data-i18n="products">Products</strong>
          </nav>
        </div>
      </section>

      <section class="products_card" aria-labelledby="products-table-title">
        <div class="card_heading">
          <div>
            <h2 id="products-table-title" data-i18n="productList">Products List</h2>
            <p data-i18n="productListSubtitle">Manage inventory, availability and product details.</p>
          </div>
          <div class="card_actions">
            <button class="primary_button" id="process-btn" type="button"><span aria-hidden="true">＋</span><span data-i18n="addProduct">Add Product</span></button>
          </div>
        </div>

        <div class="products_toolbar">
          <div class="table_search_group">
            <span class="table_search_context" data-i18n="tableSearchLabel">Search this table</span>
            <label class="table_search">
              <span aria-hidden="true">⌕</span>
              <input id="product-table-search" type="search" data-i18n-placeholder="tableSearch" placeholder="Search products..." />
            </label>
          </div>
          <div class="bulk_actions_bar" id="bulk-actions-bar" hidden>
            <strong id="selected-products-count">0 selected</strong>
            <button class="bulk_delete_button" id="delete-selected-products" type="button" data-i18n="deleteSelected">Delete selected</button>
            <label class="bulk_status_control"><span data-i18n="changeStatus">Change status</span><select id="bulk-status-select"><option value="" selected data-i18n="chooseStatus">Choose status</option><option value="PROCESS" data-i18n="active">Active</option><option value="PAUSE" data-i18n="paused">Paused</option><option value="DELETE" data-i18n="deleted">Deleted</option></select></label>
          </div>
          <div class="filter_control">
            <button class="secondary_button filter_button" id="product-filter-toggle" type="button" aria-expanded="false" aria-controls="product-filters"><span aria-hidden="true">☷</span><span data-i18n="filter">Filter</span><strong id="active-filter-count" hidden>0</strong></button>
            <div class="product_filters" id="product-filters" hidden>
              <label><span data-i18n="category">Category</span><input id="product-category-filter" type="search" list="product-category-options" autocomplete="off" data-i18n-placeholder="searchCategory" placeholder="Search category..." /></label>
              <datalist id="product-category-options"><option value="LAPTOP"></option><option value="SMARTPHONE"></option><option value="TV"></option><option value="GAMING"></option><option value="AUDIO"></option><option value="CASES"></option><option value="OTHERS"></option></datalist>
              <label><span data-i18n="brands">Brands</span><input id="product-brand-filter" type="search" list="product-brand-options" autocomplete="off" data-i18n-placeholder="searchBrands" placeholder="Search brands..." /></label>
              <datalist id="product-brand-options"><option value="APPLE"></option><option value="SAMSUNG"></option><option value="SONY"></option><option value="LG"></option><option value="XIAOMI"></option><option value="OTHER"></option></datalist>
              <button class="apply_filters_button" id="apply-product-filters" type="button" data-i18n="applyFilters">Apply</button>
              <button class="clear_filters_button" id="clear-product-filters" type="button" data-i18n="clearFilters">Clear filters</button>
            </div>
          </div>
        </div>

        <div class="table_wrapper">
          <table class="products_table">
            <colgroup>
              <col class="col_select" />
              <col class="col_product" />
              <col class="col_category" />
              <col class="col_brand" />
              <col class="col_condition" />
              <col class="col_price" />
              <col class="col_count" />
              <col class="col_status" />
              <col class="col_added" />
              <col class="col_actions" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col" class="select_heading"><input id="select-all-products" type="checkbox" aria-label="Select all products on this page" /></th>
                <th scope="col" data-i18n="product">Product</th>
                <th scope="col" data-i18n="category">Category</th>
                <th scope="col" data-i18n="brand">Brand</th>
                <th scope="col" data-i18n="condition">Condition</th>
                <th scope="col" class="numeric_heading" data-i18n="price">Price</th>
                <th scope="col" class="product_count_heading numeric_heading" data-i18n="stock">Stock</th>
                <th scope="col" data-i18n="status">Status</th>
                <th scope="col" data-i18n="added">Added</th>
                <th scope="col" class="actions_heading"><span class="sr_only" data-i18n="actions">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function (product, index) { %>
                <%
                  const normalizedName = String(product.productName || '').toLowerCase();
                  const inferredBrand = normalizedName.includes('iphone') || normalizedName.includes('macbook') || normalizedName.includes('apple')
                    ? 'APPLE'
                    : normalizedName.includes('samsung') || normalizedName.includes('galaxy')
                      ? 'SAMSUNG'
                      : normalizedName.includes('sony')
                        ? 'SONY'
                        : normalizedName.includes('xiaomi') || normalizedName.includes('redmi')
                          ? 'XIAOMI'
                          : normalizedName.includes('lg')
                            ? 'LG'
                            : 'OTHER';
                  const displayBrand = product.productBrand && product.productBrand !== 'OTHER' ? product.productBrand : inferredBrand;
                %>
                <tr class="product_row" data-product-id="<%= product._id %>" data-category="<%= ['LAPTOP', 'SMARTPHONE', 'TV', 'GAMING', 'AUDIO', 'CASES', 'OTHERS'].includes(product.productCategory) ? product.productCategory : 'OTHERS' %>" data-brand="<%= displayBrand %>" data-condition="<%= product.productCondition || 'NEW' %>" data-status="<%= product.productStatus %>" data-search="<%= [product.productName, product.productCategory, displayBrand, product.productCondition, product.productStatus].join(' ').toLowerCase() %>">
                  <td class="select_cell"><input class="product_select_checkbox" type="checkbox" value="<%= product._id %>" aria-label="Select <%= product.productName %>" /></td>
                  <td>
                    <div class="product_identity">
                      <span class="product_row_number" aria-label="Product number"><%= index + 1 %></span>
                      <% if (product.productImages && product.productImages[0]) { %>
                        <img
                          src="/<%= product.productImages[0].replace(/\\/g, '/') %>"
                          alt=""
                        />
                      <% } else { %>
                        <span class="product_placeholder" aria-hidden="true"></span>
                      <% } %>
                      <span class="product_copy"><strong title="<%= product.productName %>"><%= product.productName %></strong></span>
                    </div>
                  </td>
                  <td><%= ['LAPTOP', 'SMARTPHONE', 'TV', 'GAMING', 'AUDIO', 'CASES', 'OTHERS'].includes(product.productCategory) ? product.productCategory : 'OTHERS' %></td>
                  <td><span class="brand_badge"><%= displayBrand %></span></td>
                  <td>
                    <select
                      class="condition_select new-product-condition condition_<%= (product.productCondition || 'new').toLowerCase() %>"
                      data-product-id="<%= product._id %>"
                      aria-label="Condition for <%= product.productName %>"
                    >
                      <option value="NEW" data-i18n="newCondition" <%= product.productCondition === 'NEW' ? 'selected' : '' %>>New</option>
                      <option value="USED" data-i18n="usedCondition" <%= product.productCondition === 'USED' ? 'selected' : '' %>>Used</option>
                    </select>
                  </td>
                  <td class="product_price numeric_cell">$<%= Number(product.productPrice).toLocaleString() %></td>
                  <td class="product_count numeric_cell"><span><%= Number(product.productLeftCount).toLocaleString('en-US') %></span></td>
                  <td>
                    <select
                      class="status_select new-product-status status_<%= product.productStatus.toLowerCase() %>"
                      data-product-id="<%= product._id %>"
                      aria-label="Status for <%= product.productName %>"
                    >
                      <option value="PAUSE" data-i18n="paused" <%= product.productStatus === 'PAUSE' ? 'selected' : '' %>>Paused</option>
                      <option value="PROCESS" data-i18n="active" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>Active</option>
                      <option value="DELETE" data-i18n="deleted" <%= product.productStatus === 'DELETE' ? 'selected' : '' %>>Deleted</option>
                    </select>
                  </td>
                  <td class="product_date"><%= product.createdAt ? new Date(product.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
                  <td class="product_actions_cell">
                    <button class="row_actions_toggle" type="button" aria-label="Actions for <%= product.productName %>" aria-expanded="false">•••</button>
                    <div class="row_actions_menu" hidden>
                      <button type="button" data-product-action="view" data-i18n="viewMore">View More</button>
                      <button type="button" class="delete_action" data-product-action="delete" data-i18n="deleteProduct">Delete</button>
                    </div>
                  </td>
                </tr>
              <% }) %>

              <% if (!products.length) { %>
                <tr>
                  <td class="empty_state" colspan="10" data-i18n="emptyProducts">No products have been added yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <footer class="table_footer" <%= products.length ? '' : 'hidden' %>>
          <p id="products-result-count"></p>
          <nav class="table_pagination" id="products-pagination" aria-label="Product pages"></nav>
        </footer>
      </section>

      <form
        class="product_form"
        id="product-form"
        action="/admin/product/create"
        method="POST"
        enctype="multipart/form-data"
        novalidate
      >
        <div class="form_heading">
          <div>
            <p class="section_label">NEW INVENTORY</p>
            <h2>Add New Product</h2>
            <p>Enter the product details and upload at least one image.</p>
          </div>
          <button class="close_form_button" id="cancel-btn" type="button" aria-label="Close form">×</button>
        </div>

        <input name="productStatus" value="PAUSE" type="hidden" />

        <div class="form_grid">
          <div class="form_field field_full">
            <label for="product-name">Product Name <span class="required_mark" aria-hidden="true">*</span></label>
            <input
              id="product-name"
              name="productName"
              type="text"
              placeholder="For example, Galaxy S26 Ultra"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-price">Price <span class="required_mark" aria-hidden="true">*</span></label>
            <input
              id="product-price"
              name="productPrice"
              type="number"
              min="0"
              step="0.01"
              placeholder="0.00"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-stock">Stock <span class="required_mark" aria-hidden="true">*</span></label>
            <input
              id="product-stock"
              name="productLeftCount"
              type="number"
              min="0"
              step="1"
              placeholder="0"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-category">Category <span class="required_mark" aria-hidden="true">*</span></label>
            <select id="product-category" name="productCategory" required>
              <option value="" selected disabled>Select category</option>
              <option value="LAPTOP">LAPTOP</option>
              <option value="SMARTPHONE">SMARTPHONE</option>
              <option value="TV">TV</option>
              <option value="GAMING">GAMING</option>
              <option value="AUDIO">AUDIO</option>
              <option value="CASES">CASES</option>
              <option value="OTHERS">OTHERS</option>
            </select>
          </div>

          <div class="form_field">
            <label for="product-condition">Condition <span class="required_mark" aria-hidden="true">*</span></label>
            <select id="product-condition" name="productCondition" required>
              <option value="" selected disabled>Select condition</option>
              <option value="NEW">New</option>
              <option value="USED">Used</option>
            </select>
          </div>

          <div class="form_field memory_trigger_field" id="memory-trigger-field" hidden>
            <label data-i18n="memoryStorage">Memory / Storage</label>
            <button class="add_memory_button" id="add-memory-button" type="button"><span aria-hidden="true">＋</span><span data-i18n="addMemory">Add memory / storage</span></button>
          </div>

          <div class="form_field memory_input_field" id="memory-input-field" hidden>
            <label for="product-memory" data-i18n="memoryStorage">Memory / Storage</label>
            <div class="memory_select_row">
              <select id="product-memory" name="productMemory" disabled>
                <option value="" selected data-i18n="selectMemory">Select memory</option>
                <option value="32GB">32 GB</option><option value="64GB">64 GB</option><option value="128GB">128 GB</option>
                <option value="256GB">256 GB</option><option value="512GB">512 GB</option><option value="1TB">1 TB</option><option value="2TB">2 TB</option>
              </select>
              <button class="remove_memory_button" id="remove-memory-button" type="button" aria-label="Remove memory">Remove</button>
            </div>
          </div>

          <div class="form_field memory_trigger_field" id="screen-trigger-field" hidden>
            <label data-i18n="screenSize">Screen size</label>
            <button class="add_memory_button" id="add-screen-button" type="button"><span aria-hidden="true">＋</span><span data-i18n="addScreenSize">Add TV screen size</span></button>
          </div>

          <div class="form_field memory_input_field" id="screen-input-field" hidden>
            <label for="product-screen-size" data-i18n="screenSize">Screen size</label>
            <div class="memory_select_row">
              <select id="product-screen-size" name="productScreenSize" disabled>
                <option value="" selected data-i18n="selectScreenSize">Select screen size</option>
                <option value="24">24″</option><option value="27">27″</option><option value="32">32″</option>
                <option value="43">43″</option><option value="50">50″</option><option value="55">55″</option>
                <option value="65">65″</option><option value="75">75″</option><option value="85">85″</option>
              </select>
              <button class="remove_memory_button" id="remove-screen-button" type="button" aria-label="Remove screen size">Remove</button>
            </div>
          </div>

          <div class="form_pair field_full">
            <div class="form_field">
              <label for="product-brand">Brand <span class="required_mark" aria-hidden="true">*</span></label>
              <select id="product-brand" name="productBrand" required>
                <option value="" selected disabled>Select brand</option>
                <option value="APPLE">Apple</option>
                <option value="SAMSUNG">Samsung</option>
                <option value="SONY">Sony</option>
                <option value="LG">LG</option>
                <option value="XIAOMI">Xiaomi</option>
                <option value="OTHER">Other</option>
              </select>
            </div>

            <div class="form_field">
              <label for="product-sku">SKU <span class="optional_label" data-i18n="optional">Optional</span></label>
              <input id="product-sku" name="productSku" type="text" maxlength="64" autocomplete="off" placeholder="For example, SAM-S26-256-BLK" />
            </div>
          </div>

          <div class="form_field field_full">
            <label for="product-description">Description <span class="optional_label" data-i18n="optional">Optional</span></label>
            <textarea
              id="product-description"
              name="productDesc"
              rows="5"
              placeholder="Describe the product’s main features and specifications"
              minlength="20"
            ></textarea>
            <small class="description_help" data-i18n="descriptionHelp">If provided, use at least 20 meaningful characters.</small>
          </div>
        </div>

        <fieldset class="image_upload_section">
          <legend>Product Images</legend>
          <p>Upload up to 5 JPG, JPEG or PNG images. The first image is required.</p>
          <div class="image_upload_grid">
            <% for (let imageIndex = 1; imageIndex <= 5; imageIndex++) { %>
              <label class="upload_box <%= imageIndex === 1 ? 'main_upload_box' : '' %>" for="product-image-<%= imageIndex %>">
                <% if (imageIndex === 1) { %><small class="required_badge">Required</small><% } %>
                <img id="image-preview-<%= imageIndex %>" src="/img/upload.svg" alt="Image <%= imageIndex %> preview" />
                <span><%= imageIndex === 1 ? 'Main image' : 'Add image' %></span>
                <input
                  id="product-image-<%= imageIndex %>"
                  name="productImages"
                  type="file"
                  accept="image/jpeg,image/png"
                  data-preview-index="<%= imageIndex %>"
                  <%= imageIndex === 1 ? 'required' : '' %>
                />
              </label>
            <% } %>
          </div>
        </fieldset>

        <div class="form_actions">
          <button class="secondary_button" id="reset-btn" type="reset">Clear</button>
          <button class="primary_button" type="submit">Create Product</button>
        </div>
      </form>
      </main>
    </section>
  </div>

  <script src="/js/admin-shell.js"></script>
  <script src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
