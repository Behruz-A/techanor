<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<script>
  (function restoreTechanorTheme() {
    try {
      document.documentElement.dataset.theme = localStorage.getItem("techanor-admin-theme") || "light";
    } catch (error) {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>

<body class="products_page">
  <div class="admin_shell">
    <aside class="admin_sidebar" id="admin-sidebar">
      <a class="sidebar_brand" href="/admin" aria-label="Techanor home">
        <img class="sidebar_brand_logo" src="/img/logoipsum-249.svg" alt="" aria-hidden="true" />
        <span><strong>Techanor</strong><small>ADMIN PANEL</small></span>
      </a>

      <p class="sidebar_label" data-i18n="general">GENERAL</p>
      <nav class="sidebar_navigation" aria-label="Admin navigation">
        <a href="/admin"><span class="nav_icon">⌂</span><span data-i18n="home">Home</span></a>
        <a class="is_active" href="/admin/product/all" aria-current="page"><span class="nav_icon">▦</span><span data-i18n="products">Products</span></a>
        <a href="/admin/analytics"><span class="nav_icon">⌁</span><span>Analytics</span></a>
        <a href="/admin/marketing"><span class="nav_icon">⌁</span><span data-i18n="marketing">Marketing</span></a>
        <a href="/admin/user/all"><span class="nav_icon">♙</span><span data-i18n="users">Users</span></a>
        <a href="/admin/blog/all"><span class="nav_icon">▤</span><span data-i18n="blogs">Blogs</span></a>
        <button class="sidebar_future_item" type="button" data-coming-soon="AI"><span>AI</span><em>NEW</em></button>
        <button class="sidebar_future_item" type="button" data-coming-soon="AI Assistant"><span>AI Assistant</span><em>NEW</em></button>
      </nav>

      <div class="sidebar_footer">
        <span><i></i><span data-i18n="systemOnline">SYSTEM ONLINE</span></span>
        <a class="sidebar_logout" href="/admin/logout" onclick="return confirm('Do you want to logout?')"><span>↪</span><span data-i18n="logout">Logout</span></a>
      </div>
    </aside>

    <section class="admin_workspace">
      <header class="workspace_header">
        <button class="sidebar_toggle" id="sidebar-toggle" type="button" aria-label="Toggle navigation">☰</button>
        <label class="global_search">
          <span>⌕</span>
          <input id="product-search" type="search" data-i18n-placeholder="search" placeholder="Search products..." />
        </label>
        <div class="header_actions">
          <label class="language_picker" for="language-select">
            <span>文</span>
            <select id="language-select" aria-label="Language">
              <option value="en" selected>English</option>
              <option value="ko">한국어</option>
              <option value="uz">O‘zbek</option>
            </select>
          </label>
          <button class="theme_toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
            <span class="theme_icon theme_icon_sun" aria-hidden="true">☀</span>
            <span class="theme_icon theme_icon_moon" aria-hidden="true">☾</span>
          </button>
          <div class="admin_identity">
            <img src="/img/Asensio.png" alt="Ryan" />
            <div><strong>Ryan</strong><small>Admin</small></div>
          </div>
        </div>
      </header>

      <main class="products_content">
      <section class="products_heading">
        <div>
          <p class="section_label" data-i18n="catalog">STORE CATALOG</p>
          <h1 data-i18n="productManagement">Product Management</h1>
          <p data-i18n="productSubtitle">Manage your Techanor products, stock and availability.</p>
        </div>
        <button class="primary_button" id="process-btn" type="button">
          <span>＋</span> <span data-i18n="addProduct">Add Product</span>
        </button>
      </section>

      <section class="products_card" aria-labelledby="products-table-title">
        <div class="card_heading">
          <div>
            <h2 id="products-table-title" data-i18n="productList">Product List</h2>
            <p><span data-i18n="totalProducts">Total products</span>: <%= products.length %></p>
          </div>
        </div>

        <div class="table_wrapper">
          <table class="products_table">
            <thead>
              <tr>
                <th scope="col" data-i18n="number">No.</th>
                <th scope="col" data-i18n="product">Product</th>
                <th scope="col" data-i18n="category">Category</th>
                <th scope="col" data-i18n="brand">Brand</th>
                <th scope="col" data-i18n="condition">Condition</th>
                <th scope="col" data-i18n="price">Price</th>
                <th scope="col" data-i18n="stock">Stock</th>
                <th scope="col" data-i18n="status">Status</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function (product, index) { %>
                <%
                  const normalizedName = String(product.productName || '').toLowerCase();
                  const inferredBrand = normalizedName.includes('iphone') || normalizedName.includes('macbook') || normalizedName.includes('apple')
                    ? 'APPLE'
                    : normalizedName.includes('samsung') || normalizedName.includes('galaxy')
                      ? 'SAMSUNG'
                      : normalizedName.includes('sony')
                        ? 'SONY'
                        : normalizedName.includes('xiaomi') || normalizedName.includes('redmi')
                          ? 'XIAOMI'
                          : normalizedName.includes('lg')
                            ? 'LG'
                            : 'OTHER';
                  const displayBrand = product.productBrand && product.productBrand !== 'OTHER' ? product.productBrand : inferredBrand;
                %>
                <tr class="product_row" data-search="<%= [product.productName, product.productCategory, displayBrand, product.productCondition, product.productStatus].join(' ').toLowerCase() %>">
                  <td class="row_number"><%= index + 1 %></td>
                  <td>
                    <div class="product_identity">
                      <% if (product.productImages && product.productImages[0]) { %>
                        <img
                          src="/<%= product.productImages[0].replace(/\\/g, '/') %>"
                          alt=""
                        />
                      <% } else { %>
                        <span class="product_placeholder" aria-hidden="true"></span>
                      <% } %>
                      <strong><%= product.productName %></strong>
                    </div>
                  </td>
                  <td><%= ['LAPTOP', 'SMARTPHONE', 'TV', 'GAMING', 'CASES', 'OTHERS'].includes(product.productCategory) ? product.productCategory : 'OTHERS' %></td>
                  <td><span class="brand_badge"><%= displayBrand %></span></td>
                  <td>
                    <span class="condition_badge condition_<%= (product.productCondition || 'unknown').toLowerCase() %>">
                      <%= product.productCondition || '—' %>
                    </span>
                  </td>
                  <td class="product_price">$<%= Number(product.productPrice).toLocaleString() %></td>
                  <td><%= product.productLeftCount %></td>
                  <td>
                    <select
                      class="status_select new-product-status status_<%= product.productStatus.toLowerCase() %>"
                      data-product-id="<%= product._id %>"
                      aria-label="Status for <%= product.productName %>"
                    >
                      <option value="PAUSE" <%= product.productStatus === 'PAUSE' ? 'selected' : '' %>>Paused</option>
                      <option value="PROCESS" <%= product.productStatus === 'PROCESS' ? 'selected' : '' %>>Active</option>
                      <option value="DELETE" <%= product.productStatus === 'DELETE' ? 'selected' : '' %>>Deleted</option>
                    </select>
                  </td>
                </tr>
              <% }) %>

              <% if (!products.length) { %>
                <tr>
                  <td class="empty_state" colspan="8" data-i18n="emptyProducts">No products have been added yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <form
        class="product_form"
        id="product-form"
        action="/admin/product/create"
        method="POST"
        enctype="multipart/form-data"
        novalidate
      >
        <div class="form_heading">
          <div>
            <p class="section_label">NEW INVENTORY</p>
            <h2>Add New Product</h2>
            <p>Enter the product details and upload at least one image.</p>
          </div>
          <button class="close_form_button" id="cancel-btn" type="button" aria-label="Close form">×</button>
        </div>

        <input name="productStatus" value="PAUSE" type="hidden" />

        <div class="form_grid">
          <div class="form_field field_full">
            <label for="product-name">Product Name</label>
            <input
              id="product-name"
              name="productName"
              type="text"
              placeholder="For example, Galaxy S26 Ultra"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-price">Price</label>
            <input
              id="product-price"
              name="productPrice"
              type="number"
              min="0"
              step="0.01"
              placeholder="0.00"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-stock">Stock</label>
            <input
              id="product-stock"
              name="productLeftCount"
              type="number"
              min="0"
              step="1"
              placeholder="0"
              required
            />
          </div>

          <div class="form_field">
            <label for="product-category">Category</label>
            <select id="product-category" name="productCategory" required>
              <option value="" selected disabled>Select category</option>
              <option value="LAPTOP">LAPTOP</option>
              <option value="SMARTPHONE">SMARTPHONE</option>
              <option value="TV">TV</option>
              <option value="GAMING">GAMING</option>
              <option value="CASES">CASES</option>
              <option value="OTHERS">OTHERS</option>
            </select>
          </div>

          <div class="form_field">
            <label for="product-condition">Condition</label>
            <select id="product-condition" name="productCondition" required>
              <option value="" selected disabled>Select condition</option>
              <option value="NEW">New</option>
              <option value="USED">Used</option>
            </select>
          </div>

          <div class="form_field">
            <label for="product-brand">Brand</label>
            <select id="product-brand" name="productBrand" required>
              <option value="" selected disabled>Select brand</option>
              <option value="APPLE">Apple</option>
              <option value="SAMSUNG">Samsung</option>
              <option value="SONY">Sony</option>
              <option value="LG">LG</option>
              <option value="XIAOMI">Xiaomi</option>
              <option value="OTHER">Other</option>
            </select>
          </div>

          <div class="form_field field_full">
            <label for="product-description">Description</label>
            <textarea
              id="product-description"
              name="productDesc"
              rows="5"
              placeholder="Describe the product’s main features and specifications"
              required
            ></textarea>
          </div>
        </div>

        <fieldset class="image_upload_section">
          <legend>Product Images</legend>
          <p>Upload up to 5 JPG, JPEG or PNG images. The first image is required.</p>
          <div class="image_upload_grid">
            <% for (let imageIndex = 1; imageIndex <= 5; imageIndex++) { %>
              <label class="upload_box" for="product-image-<%= imageIndex %>">
                <img id="image-preview-<%= imageIndex %>" src="/img/upload.svg" alt="Image <%= imageIndex %> preview" />
                <span><%= imageIndex === 1 ? 'Main image' : 'Add image' %></span>
                <input
                  id="product-image-<%= imageIndex %>"
                  name="productImages"
                  type="file"
                  accept="image/jpeg,image/png"
                  data-preview-index="<%= imageIndex %>"
                  <%= imageIndex === 1 ? 'required' : '' %>
                />
              </label>
            <% } %>
          </div>
        </fieldset>

        <div class="form_actions">
          <button class="secondary_button" id="reset-btn" type="reset">Clear</button>
          <button class="primary_button" type="submit">Create Product</button>
        </div>
      </form>
      </main>
    </section>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>
