  "description": "Techanor commerce API and administration portal",
  "license": "ISC",
  "author": "Ryan",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node src/server.ts",
