    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.6",
    "express": "^4.22.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^8.9.0",
    "mongoose": "^6.13.10",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-mongodb-session": "^2.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-session": "^1.17.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^25.9.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
